{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalmarketingco.org/schemas/atlas.schema.json",
  "title": "Spatial atlas source",
  "description": "Structural contract; source credibility and rendered page checks are separate. Coordinates also require a projection note, enforced by adapter.",
  "type": "object",
  "required": [
    "title",
    "author",
    "sections"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "abstract": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "house": {
      "type": "object"
    },
    "copyright": {
      "type": "object"
    },
    "projection": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "gazetteer": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "n",
          "text"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "biblio": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "bibliography": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "coordinates": {
          "$ref": "#/$defs/coordinates"
        }
      },
      "additionalProperties": true
    },
    "coordinates": {
      "type": "object",
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true,
      "anyOf": [
        {
          "required": [
            "source"
          ]
        },
        {
          "required": [
            "note"
          ]
        }
      ]
    },
    "section": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "body",
            "notes",
            "bibliography"
          ]
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        },
        "banner": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "href": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
